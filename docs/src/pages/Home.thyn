<script>
  import Button from "../components/Button.thyn";
  const count = $signal(0);

  const taglines = [
    "The healthy choice for your codebase.",
    "Thyn is in. Bloat is out.",
    "So thyn, it barely exists.",
  ];

  const tagline = $signal(0);
  $effect(() => {
    const interval = setInterval(() => tagline.update(t => t + 1), 5000);
    return () => clearInterval(interval);
  });

  setTimeout(() => {
    Prism.highlightAll();
  });
</script>

<div class="main">
  <h1>
    <img src="/thyn.svg" />
    thyn
  </h1>
  <p class="tagline">{{ taglines[tagline.get() % taglines.length] }}</p>
  <div class="compiled-wrapper">
    <div>
      <h4>source</h4>
      <pre>
        <code class="code language-javascript">
// App.thyn
&lt;script&gt;
  const count = $signal(0);
&lt;\/script&gt;

&lt;button onclick={() =&gt; count.update(c =&gt; c + 1)}&gt;
  Count: \{{ count.get() \}}
&lt;/button&gt;

&lt;style&gt;
  button {
    background: #333;
  }
&lt;/style&gt;

// main.js
import { mount } from '@thyn/core';
import App from './App.thyn';

mount(App, document.body);          
