<script>
  // Test: filter items
  const items = $signal([1, 2, 3, 4, 5, 6]);
  let clickCount = 0;
</script>

<div onclick={() => {
  clickCount++;
  if (clickCount === 1) items([2, 4, 6]); // Even only
  else if (clickCount === 2) items([1, 3, 5]); // Odd only
  else items([10, 15, 20]); // Greater than 5
}}>
  <span #for={item in items()} data-id={item}>
    {{ item }}
  </span>
</div>
