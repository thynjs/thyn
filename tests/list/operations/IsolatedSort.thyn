<script>
  // Test: sort items
  const items = $signal([3, 1, 4, 5]);
  let clickCount = 0;
</script>

<div onclick={() => {
  clickCount++;
  if (clickCount === 1) items([1, 3, 4, 5]); // Ascending
  else if (clickCount === 2) items([5, 4, 3, 1]); // Descending
  else items([5, 4, 3, 2, 1]); // Reverse
}}>
  <span #for={item in items()} data-id={item}>
    {{ item }}
  </span>
</div>
