<script>
  // Test: none → some (add items to empty list)
  const items = $signal([]);
  let clickCount = 0;
</script>

<div onclick={() => {
  clickCount++;
  if (clickCount === 1) items([1]);
  else if (clickCount === 2) items([1, 2, 3]);
  else items([]);
}}>
  <span #for={item in items()} data-id={item}>
    {{ item }}
  </span>
</div>
