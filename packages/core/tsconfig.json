{
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": ".",
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "types/**/*.d.ts"
  ]
}