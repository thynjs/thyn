{
  "compilerOptions": {
    "composite": true,
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ESNext"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["src"],
  "references": [
    { "path": "../vite-plugin" }
  ]
}
