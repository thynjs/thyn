{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "thyn",
      "camelcase": "Thyn",
      "title": "Thyn",
      "scope": "source.thyn",
      "file-types": [
        "thyn"
      ],
      "injection-regex": "^thyn$",
      "class-name": "TreeSitterThyn"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Thyn grammar for tree-sitter",
    "authors": [
      {
        "name": "Travis Harmon",
        "email": "harmtrav@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-thyn"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}