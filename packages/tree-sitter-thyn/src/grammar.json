        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "javascript_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "</script>"
        }
      ]
    },
    "javascript_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
