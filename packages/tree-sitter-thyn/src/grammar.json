  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "PATTERN",
      "value": "\\/\\/.*\\n"
    },
    {
      "type": "PATTERN",
      "value": "\\/\\*[^*]*\\*+([^/*][^*]*\\*+)*\\/"
