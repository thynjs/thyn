            "type": "SYMBOL",
            "name": "_js_expression"
          }
        ]
      }
    },
    "property_access": {
      "type": "PREC_LEFT",
      "value": 4,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
