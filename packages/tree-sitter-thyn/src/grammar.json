    "attribute_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[a-zA-Z][a-zA-Z0-9-]*"
        }
      }
    },
