        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "SYMBOL",
          "name": "_js_expression"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "expression_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_js_expression"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "_js_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "signal_call"
        },
        {
          "type": "SYMBOL",
          "name": "array"
        },
        {
          "type": "SYMBOL",
          "name": "arrow_function"
        },
        {
          "type": "SYMBOL",
          "name": "function_call"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized_expression"
        },
        {
          "type": "SYMBOL",
          "name": "spread_expression"
        },
        {
          "type": "SYMBOL",
          "name": "property_access"
        },
        {
          "type": "SYMBOL",
          "name": "for_expression"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
