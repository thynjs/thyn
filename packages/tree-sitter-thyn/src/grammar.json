    "open_tag_start": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "<"
      }
    },
    "open_tag_end": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": ">"
      }
    },
    "close_tag_start": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "</"
      }
    },
    "close_tag_end": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": ">"
      }
