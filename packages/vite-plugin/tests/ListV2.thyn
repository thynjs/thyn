<script>
  const items = $signal([$signal(0), $signal(1), $signal(2)]);
  const selected = $signal(1);
</script>

<div onclick={() => items(v => v.length === 4 ? [] : [...v, $signal(v.length)])}>
  <p>
    start 
  </p>
  <p #for={item in items()} class={selected() === item() ? 'selected' : undefined} id={item()}>
    {{ item() }}
  </p>
  <p>
    end
  </p>
</div>
