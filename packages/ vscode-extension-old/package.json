{
  "name": "thyn",
  "displayName": "Thyn",
  "description": "Thyn single file component support",
  "repository": {
    "url": "https://github.com/thynjs/thyn"
  },
  "scripts": {
    "build": "webpack --config webpack.extension.js && webpack --config webpack.server.js"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:thyn"
  ],
  "contributes": {
    "languages": [
      {
        "id": "thyn",
        "aliases": [
          "Thyn",
          "thyn"
        ],
        "extensions": [
          ".thyn"
        ],
        "configuration": "./languages/thyn.json"
      }
    ],
    "commands": [
      {
        "command": "thyn.openScript",
        "title": "Thyn: Open Script"
      },
      {
        "command": "thyn.openStyle",
        "title": "Thyn: Open Style"
      }
    ],
    "grammars": [
      {
        "language": "thyn",
        "scopeName": "source.thyn",
        "path": "./syntaxes/thyn.tmLanguage.json",
        "embeddedLanguages": {
          "source.thyn": "thyn",
          "text": "plaintext",
          "text.html.derivative": "html",
          "source.css": "css",
          "source.js": "javascript",
          "source.ts": "typescript"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.5",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@types/typescript": "^0.4.29",
    "acorn": "^8.14.1",
    "acorn-walk": "^8.3.4",
    "jsdom": "^26.1.0",
    "magic-string": "^0.30.17",
    "source-map": "^0.7.4",
    "typescript": "^5.8.3",
    "vscode-css-languageservice": "^6.3.6",
    "vscode-html-languageservice": "^5.5.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-test": "^1.6.1"
  }
}